<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Password Changed - GPS Map Camera ENT</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f4f6f8;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f4f6f8'>
      <tr>
        <td align='center' style='padding:20px 10px;'>
          <!-- Main Container -->
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            '
          >
            <!-- Logo -->
            <tr>
              <td style='padding:20px 20px 10px;'>
                <img src='https://api.gpsmapcamera.com/public/images/ent-logo.png' alt='GPS Map Camera ENT' width='150' style='display:block;' />
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0; font-size:15px; color:#333333;'>
                  Hi
                  <strong>{{fName}}</strong>,
                </p>
              </td>
            </tr>

            <!-- Main Message -->
            <tr>
              <td style='padding:0 20px 10px;'>
                <p style='margin:0; font-size:16px; color:#111111; font-weight:600;'>
                  Your account password has been successfully changed.
                </p>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  We're confirming that your GPS Map Camera ENT account password was recently updated. This is a security notification to ensure
                  you're aware of this change.
                </p>
              </td>
            </tr>

            <!-- Activity Details -->

            <!-- Security Alert -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  If you
                  <strong>did not make this change</strong>, please contact our support team immediately to secure your account.
                </p>

                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='
                    background-color:#fff8f8;
                    border:1px solid #ffebee;
                    border-radius:6px;
                    padding:12px 16px;
                    margin-top:8px;
                  '
                >
                  <tr>
                    <td>
                      <p style='margin:0; font-size:13px; color:#d32f2f;'>
                        <strong>⚠️ Security Notice:</strong>
                        If this wasn't you, your account may have been compromised. Please act immediately by contacting support or resetting your
                        password through the "Forgot Password" option.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Closing -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  Thank you for choosing
                  <strong>GPS Map Camera ENT</strong>
                  and for helping us keep your account secure.
                </p>
              </td>
            </tr>

            <!-- Signature -->
            <tr>
              <td style='padding:10px 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Best regards,
                </p>
                <p style='margin:0; font-size:14px; color:#555555; font-weight:600;'>
                  GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer Note -->
            <tr>
              <td align='center' style='padding:10px 20px 5px;'>
                <p style='margin:0; font-size:12px; color:#999999;'>
                  This email can't receive replies.
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:15px; background-color:#f4f6f8; border-radius:0 0 6px 6px;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>