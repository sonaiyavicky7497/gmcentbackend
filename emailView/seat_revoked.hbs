<!DOCTYPE html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Account Status Update - GPS Map Camera ENT</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f4f6f8'>
      <tr>
        <td align='center' style='padding:20px 10px;'>
          <!-- Main Container -->
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            '
          >
            <!-- Logo -->
            <tr>
              <td style='padding:20px;'>
                <img src='https://api.gpsmapcamera.com/public/images/ent-logo.png' alt='GPS Map Camera ENT' width='150' style='display:block;' />
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style='padding:0 20px 10px;'>
                <p style='margin:0; font-size:15px; color:#333333;'>
                  Hello
                  <strong>{{userName}}</strong>,
                </p>
              </td>
            </tr>

            <!-- Main Message -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 12px; font-size:15px; color:#111111; font-weight:600;'>
                  🔒 Account Access Update
                </p>

                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  This email is to inform you that your access to <strong>{{companyName}}</strong>'s GPS Map Camera ENT account has been <strong>{{status}}</strong>.
                </p>
              </td>
            </tr>

            <!-- Details Box -->
            <tr>
              <td style='padding:20px;'>
                <table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#f1f3f6; border-radius:6px; border-left:4px solid #dc3545;'>
                  <tr>
                    <td style='padding:15px;'>
                      <p style='margin:0 0 10px; font-size:16px; color:#333333; font-weight:600;'>
                        Account Details
                      </p>

                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Organization:</strong> {{companyName}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Enterprise ID:</strong> {{companyId}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>License Code:</strong> {{licenseCode}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Your Email:</strong> {{userEmail}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Action Taken:</strong> {{action}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Date:</strong> {{actionDate}}
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Reason -->
            <tr>
              <td style='padding:0 20px;'>
                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  <strong>Reason:</strong> {{reason}}
                </p>
              </td>
            </tr>

            <!-- Impact -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 6px; font-size:15px; color:#111111; font-weight:600;'>
                  📋 What this means:
                </p>

                <ul style='margin:0 0 12px; padding-left:20px; font-size:14px; color:#555555; line-height:1.6;'>
                  <li>You will no longer be able to access {{companyName}}'s GPS Map Camera ENT services</li>
                  <li>Your license has been revoked</li>
                  <li>If you were an active user, you've been logged out from all devices</li>
                </ul>
              </td>
            </tr>

            <!-- Note Box -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#fff3cd; border-left:4px solid #ffc107; border-radius:6px;'>
                  <tr>
                    <td style='padding:15px;'>
                      <p style='margin:0; font-size:14px; color:#856404; line-height:1.6;'>
                        <strong>Note:</strong> If you believe this is a mistake or have any questions, please contact the administrator of <strong>{{companyName}}</strong> directly.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Support Info -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  For any technical assistance or inquiries about GPS Map Camera ENT, you can reach our support team:
                </p>

                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  👉 Email us at:
                  <a
                    href='mailto:{{supportEmail}}'
                    style='color:#2d2f9e; text-decoration:none; font-weight:600;'
                  >
                    {{supportEmail}}
                  </a>
                </p>

                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  👉 Or visit our support page:
                  <a
                    href='https://enterprise.gpsmapcamera.com/#contact'
                    target='_blank'
                    style='color:#2d2f9e; text-decoration:none; font-weight:600;'
                  >
                    Contact Support
                  </a>
                </p>
              </td>
            </tr>

            <!-- Closing -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  Thank you for using GPS Map Camera ENT.
                </p>
              </td>
            </tr>

            <!-- Signature -->
            <tr>
              <td style='padding:10px 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Best regards,
                </p>
                <p style='margin:0; font-size:14px; color:#555555; font-weight:600;'>
                  GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:12px; background-color:#f4f6f8;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
                <p style='margin:5px 0 0; font-size:11px; color:#aaaaaa;'>
                  This is an automated notification email. Please do not reply to this message.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>