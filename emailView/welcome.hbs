<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to GPS Map Camera ENT</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f4f6f8;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f4f6f8'>
      <tr>
        <td align='center' style='padding:20px 10px;'>
          <!-- Main Container -->
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            '
          >
            <!-- Logo -->
            <tr>
              <td style='padding:20px 20px 10px;'>
                <img src='https://api.gpsmapcamera.com/public/images/ent-logo.png' alt='GPS Map Camera ENT' width='150' style='display:block;' />
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0; font-size:15px; color:#333333;'>
                  Hello
                  <strong>{{name}}</strong>,
                </p>
              </td>
            </tr>

            <!-- Welcome Text -->
            <tr>
              <td style='padding:0 20px 10px;'>
                <p style='margin:0; font-size:16px; color:#111111; font-weight:600;'>
                  Welcome to GPS Map Camera ENT!
                </p>
              </td>
            </tr>

            <!-- Body Content -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  Thank you for registering
                  <strong>{{companyName}}</strong>
                  with us. Your enterprise account has been successfully created. You can now log in to access GPS Map Camera ENT’s professional tools
                  designed for accurate location-based documentation and workflow efficiency.
                </p>

                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  You’re just one step away from getting started. Log in to your account to explore features, manage settings, and begin using the
                  platform for your business needs.
                </p>
              </td>
            </tr>

            <!-- Get Started -->
            <tr>
              <td style='padding:20px;'>
                <p style='margin:0 0 8px; font-size:15px; color:#111111; font-weight:600;'>
                  🚀 Get Started
                </p>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Download the
                  <strong>GPS Map Camera ENT</strong>
                  app from the links below and activate your premium features.
                </p>
              </td>
            </tr>

            <!-- App Buttons -->
            <tr>
              <td align='center' style='padding:10px 20px 20px;'>
                <table cellpadding='0' cellspacing='0' border='0'>
                  <tr>
                    <td style='padding:0 8px;'>
                      <a
                        href='https://play.google.com/store/apps/details?id=com.gpsmapcamera.geotagginglocationonphoto.enterprise&utm_source=welcomemail'
                        target='_blank'
                      >
                        <img
                          src='https://api.gpsmapcamera.com/public/images/playstoreog.png'
                          alt='Google Play Store'
                          width='120'
                          style='display:block;'
                        />
                      </a>
                    </td>
                    <td style='padding:0 8px;'>
                      <a href='https://apps.apple.com/us/app/gps-map-camera-enterprise/id6758610850' target='_blank'>
                        <img
                          src='https://api.gpsmapcamera.com/public/images/appstoreog.png'
                          alt='Apple App Store'
                          width='120'
                          style='display:block;'
                        />
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Support -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  If you require any assistance or have questions during onboarding, our support team is always here to help.
                </p>
                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  We’re excited to have you with us and look forward to supporting your success.
                </p>
              </td>
            </tr>

            <!-- Signature -->
            <tr>
              <td style='padding:10px 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Best regards,
                </p>
                <p style='margin:0; font-size:14px; color:#555555; font-weight:600;'>
                  GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:15px; background-color:#f4f6f8;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>