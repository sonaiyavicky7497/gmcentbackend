<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Reset Your Password</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f9f9f9;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f9f9f9'>
      <tr>
        <td align='center'>

          <!-- Main Container -->
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            align='center'
            style='max-width:600px; background-color:#ffffff; font-family:Arial, Helvetica, sans-serif;'
          >

            <!-- Logo -->
            <tr>
              <td style='padding:20px;'>
                <img
                  src='https://api.gpsmapcamera.com/public/images/ent-logo.png'
                  alt='GPS Map Camera ENT'
                  width='150'
                  style='display:block; border:0; outline:none;'
                />
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style='padding:0 20px 20px; color:#333333; font-size:14px; line-height:1.6;'>
                <p>Dear {{name}},</p>

                <p>
                  We received a request to reset the password for your account.
                </p>

                <p>
                  If you made this request, please click the link below to reset your password:
                </p>

                <p style='margin:12px 0; font-weight:bold;'>
                  Reset Password Link:
                </p>

                <p style='word-break:break-all;'>
                  <a href='{{url}}' style='color:#1a73e8; text-decoration:none;'>
                    {{url}}
                  </a>
                </p>

                <p style='margin-top:16px;'>
                  ⏰
                  <strong>Note:</strong>
                  This password reset link is valid until
                  <strong>{{expireAt}}</strong>.
                </p>

                <p>
                  If you did not request a password reset, please ignore this email. Your account will remain secure.
                </p>

                <p>
                  If you need any further assistance, feel free to contact our support team.
                </p>

                <p style='margin:20px 0 4px;'>
                  Warm regards,
                </p>
                <p style='margin:0; font-weight:bold;'>
                  Team GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:12px; background-color:#f4f6f8;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
          <!-- End Container -->

        </td>
      </tr>
    </table>
  </body>
</html>