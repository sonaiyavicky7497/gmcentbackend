<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Verify Your Email - GPS Map Camera ENT</title>
  </head>

  <body style="margin:0; padding:0; background-color:#f4f6f8;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f4f6f8">
      <tr>
        <td align="center" style="padding:20px 10px;">
          <!-- Main Container -->
          <table
            width="600"
            cellpadding="0"
            cellspacing="0"
            border="0"
            style="
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            "
          >
            <!-- Logo -->
            <tr>
              <td style="padding:20px;">
                <img
                  src="https://api.gpsmapcamera.com/public/images/ent-logo.png"
                  alt="GPS Map Camera ENT"
                  width="150"
                  style="display:block;"
                />
              </td>
            </tr>

            <!-- Content -->
            <tr>
              <td style="padding:0 20px 10px;">
                <p style="margin:0; font-size:15px; color:#333333;">
                  <strong>Dear {{name}},</strong>
                </p>
              </td>
            </tr>

            <tr>
              <td style="padding:10px 20px;">
                <p style="margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;">
                  We have received a registration request for your
                  <strong>GPS Map Camera ENT</strong> account.
                </p>

                <p style="margin:0 0 16px; font-size:14px; color:#555555; line-height:1.6;">
                  To ensure the security of your account, please verify your email
                  address by entering the following One-Time Password (OTP):
                </p>
              </td>
            </tr>

            <!-- OTP -->
            <tr>
              <td align="center" style="padding:10px 20px;">
                <div
                  style="
                    display:inline-block;
                    background-color:#eef0ff;
                    color:#2d2f9e;
                    letter-spacing:4px;
                    padding:12px 20px;
                    border-radius:6px;
                    font-size:22px;
                    font-weight:bold;
                  "
                >
                  {{otp}}
                </div>
              </td>
            </tr>

            <!-- OTP Info -->
            <tr>
              <td style="padding:20px;">
                <p style="margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;">
                  Please enter this OTP to complete your email verification.
                </p>

                <p style="margin:0 0 10px; font-size:14px; color:#555555;">
                  This OTP is valid for <strong>5 minutes</strong> only.
                </p>

                <p style="margin:0; font-size:14px; color:#d9534f; font-weight:600;">
                  For security reasons, do not share this OTP with anyone.
                </p>
              </td>
            </tr>

            <!-- Closing -->
            <tr>
              <td style="padding:10px 20px 20px;">
                <p style="margin:0 0 10px; font-size:14px; color:#555555;">
                  Thank you for choosing <strong>GPS Map Camera ENT</strong>.
                </p>

                <p style="margin:0; font-size:14px; color:#555555;">
                  Best regards,
                </p>
                <p style="margin:0; font-size:14px; color:#555555; font-weight:600;">
                GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer Note -->
            <tr>
              <td align="center" style="padding:10px;">
                <p style="margin:0; font-size:12px; color:#999999;">
                  This email can’t receive replies.
                </p>
              </td>
            </tr>

            <!-- Copyright -->
            <tr>
              <td align="center" style="padding:12px; background-color:#f4f6f8;">
                <p style="margin:0; font-size:12px; color:#888888;">
                  © GPS Map Camera ENT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>