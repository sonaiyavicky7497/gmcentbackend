<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Account Deleted - GPS Map Camera ENT</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f4f6f8; font-family: Arial, Helvetica, sans-serif;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f4f6f8'>
      <tr>
        <td align='center' style='padding:20px 10px;'>
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            '
          >
            <tr>
              <td style='padding:20px;'>
                <img src='https://api.gpsmapcamera.com/public/images/ent-logo.png' alt='GPS Map Camera ENT' width='150' style='display:block;' />
              </td>
            </tr>

            <tr>
              <td style='padding:0 20px 10px;'>
                <p style='margin:0; font-size:15px; color:#333333;'>
                  Hello
                  <strong>{{userName}}</strong>,
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 12px; font-size:15px; color:#d9534f; font-weight:600;'>
                  ⚠️ Account Deletion Notice
                </p>

                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  This email is to confirm that your account has been
                  <strong>permanently deleted</strong>
                  from the GPS Map Camera ENT system.
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding:20px;'>
                <table
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='background-color:#f8f9fa; border-radius:6px; border-left:4px solid #6c757d;'
                >
                  <tr>
                    <td style='padding:15px;'>
                      <p style='margin:0 0 10px; font-size:16px; color:#333333; font-weight:600;'>
                        Deletion Summary
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>User Name:</strong>
                        {{userName}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>User Email:</strong>
                        {{email}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Date of Deletion:</strong>
                        {{createdAt}}
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 6px; font-size:15px; color:#111111; font-weight:600;'>
                  📋 Important Information:
                </p>

                <ul style='margin:0 0 12px; padding-left:20px; font-size:14px; color:#555555; line-height:1.6;'>
                  <li>You no longer have access to the Enterprise dashboard or mobile features.</li>
                  <li>All active sessions for this account have been terminated.</li>
                  <li>Data associated with your profile has been handled according to your organization's data retention policy.</li>
                </ul>
              </td>
            </tr>

            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  For general technical questions regarding the platform:
                </p>

                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  👉 Support Email:
                  <a href='mailto:{{supportEmail}}' style='color:#2d2f9e; text-decoration:none; font-weight:600;'>
                    {{supportEmail}}
                  </a>
                </p>
              </td>
            </tr>

            <tr>
              <td style='padding:10px 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Best regards,
                </p>
                <p style='margin:0; font-size:14px; color:#555555; font-weight:600;'>
                  GPS Map Camera ENT Team
                </p>
              </td>
            </tr>

            <tr>
              <td align='center' style='padding:12px; background-color:#f4f6f8;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
                <p style='margin:5px 0 0; font-size:11px; color:#aaaaaa;'>
                  This is an automated security notification. Please do not reply to this email.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>