<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Welcome to GPS Map Camera ENT</title>
  </head>

  <body style='margin:0; padding:0; background-color:#f4f6f8;'>
    <table width='100%' cellpadding='0' cellspacing='0' border='0' bgcolor='#f4f6f8'>
      <tr>
        <td align='center' style='padding:20px 10px;'>
          <!-- Main Container -->
          <table
            width='600'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width:600px;
              background-color:#ffffff;
              border-radius:6px;
              font-family: Arial, Helvetica, sans-serif;
            '
          >
            <!-- Logo -->
            <tr>
              <td style='padding:20px;'>
                <img src='https://api.gpsmapcamera.com/public/images/ent-logo.png' alt='GPS Map Camera ENT' width='150' style='display:block;' />
              </td>
            </tr>

            <!-- Greeting -->
            <tr>
              <td style='padding:0 20px 10px;'>
                <p style='margin:0; font-size:15px; color:#333333;'>
                  Hello
                  <strong>{{name}}</strong>,
                </p>
              </td>
            </tr>

            <!-- Intro -->
            <tr>
              <td style='padding:10px 20px;'>
                <p style='margin:0 0 12px; font-size:15px; color:#111111; font-weight:600;'>
                  👋 You’ve been invited!
                </p>

                <p style='margin:0 0 12px; font-size:15px; color:#111111;'>
                  <b>{{companyName}}</b>
                  has invited you to join their organization on
                  <b>GPS Map Camera Enterprise.</b>
                </p>

                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  We’re excited to have you on board and thank you for choosing our enterprise solution.
                </p>

                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  You’re all set to unlock the full potential of GPS Map Camera ENT with powerful, premium features designed to enhance authenticity,
                  efficiency, and workflow management.
                </p>
              </td>
            </tr>

            <!-- License Details -->
            <tr>
              <td style='padding:20px;'>
                <table width='100%' cellpadding='0' cellspacing='0' border='0' style='background-color:#f1f3f6; border-radius:6px;'>
                  <tr>
                    <td style='padding:15px;'>
                      <p style='margin:0 0 10px; font-size:16px; color:#333333; font-weight:600;'>
                        Your Exclusive License Details
                      </p>

                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Email:</strong>
                        {{email}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Company Name:</strong>
                        {{companyName}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>License Code:</strong>
                        {{licenseId}}
                      </p>
                      <p style='margin:6px 0; font-size:14px; color:#555555;'>
                        <strong>Enterprise ID (ENT ID):</strong>
                        {{companyId}}
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Get Started -->
            <tr>
              <td style='padding:0 20px;'>
                <p style='margin:0 0 12px; font-size:14px; color:#555555; line-height:1.6;'>
                  With this license, you now have access to our enhanced enterprise tools built to support professional documentation and operational
                  needs.
                </p>

                <p style='margin:0 0 6px; font-size:15px; color:#111111; font-weight:600;'>
                  🚀 Get Started
                </p>

                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  Download the
                  <strong>GPS Map Camera ENT</strong>
                  app from the links below and activate your premium features using the license code provided above.
                </p>
              </td>
            </tr>

            <!-- App Store Buttons -->
            <tr>
              <td align='center' style='padding:15px 20px 20px;'>
                <table cellpadding='0' cellspacing='0' border='0'>
                  <tr>
                    <td style='padding:0 8px;'>
                      <a
                        href='https://play.google.com/store/apps/details?id=com.gpsmapcamera.geotagginglocationonphoto.enterprise&utm_source=welcomemail'
                        target='_blank'
                      >
                        <img
                          src='https://api.gpsmapcamera.com/public/images/playstoreog.png'
                          alt='Google Play Store'
                          width='120'
                          style='display:block;'
                        />
                      </a>
                    </td>
                    <td style='padding:0 8px;'>
                      <a href='https://apps.apple.com/us/app/gps-map-camera-enterprise/id6758610850' target='_blank'>
                        <img
                          src='https://api.gpsmapcamera.com/public/images/appstoreog.png'
                          alt='Apple App Store'
                          width='120'
                          style='display:block;'
                        />
                      </a>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Support -->
            <tr>
              <td style='padding:0 20px 20px;'>
                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  If you need any assistance during setup or have questions at any time, our support team is just a message away.
                </p>

                <p style='margin:0 0 10px; font-size:14px; color:#555555; line-height:1.6;'>
                  👉 Visit our support page:
                  <a
                    href='https://enterprise.gpsmapcamera.com/#contact'
                    target='_blank'
                    style='color:#2d2f9e; text-decoration:none; font-weight:600;'
                  >
                    Contact Support
                  </a>
                </p>

                <p style='margin:0; font-size:14px; color:#555555; line-height:1.6;'>
                  Once again, welcome aboard—and enjoy your premium enterprise experience with GPS Map Camera ENT!
                </p>
              </td>
            </tr>

            <!-- Signature -->
            <tr>
              <td style='padding:10px 20px 20px;'>
                <p style='margin:0; font-size:14px; color:#555555;'>
                  Warm regards,
                </p>
                <p style='margin:0; font-size:14px; color:#555555; font-weight:600;'>
                  GPS Map Camera ENT
                </p>
              </td>
            </tr>

            <!-- Footer -->
            <tr>
              <td align='center' style='padding:12px; background-color:#f4f6f8;'>
                <p style='margin:0; font-size:12px; color:#888888;'>
                  © GPS Map Camera ENT. All rights reserved.
                </p>
              </td>
            </tr>

          </table>
        </td>
      </tr>
    </table>
  </body>
</html>